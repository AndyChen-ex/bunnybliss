# ============================
# ECPay 物流 API 設定
# 測試環境：https://logistics-stage.ecpay.com.tw/Helper/GetStoreList
# 正式環境：https://logistics.ecpay.com.tw/Helper/GetStoreList
# ============================

ECPAY_LOGISTICS_URL=https://logistics-stage.ecpay.com.tw/Helper/GetStoreList
ECPAY_MERCHANT_ID=your_merchant_id
ECPAY_HASH_KEY=your_hash_key
ECPAY_HASH_IV=your_hash_iv

# 若為平台商代號，填入此欄；一般廠商留空
ECPAY_PLATFORM_ID=

PORT=3000

# ============================
# Supabase 設定
# ============================
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_public_key

# ============================
# 後台管理 API 金鑰（目前用後台密碼作為 x-admin-key header）
# 若需更換請同步修改 admin.html 的 fetch headers
# ============================
# ADMIN_KEY=bunnybliss
